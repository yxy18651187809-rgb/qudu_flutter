# ============================================================
# 字趣阅读 - 环境变量配置模板
# ============================================================
# 复制此文件为 .env 并填入实际值
# ⚠️  .env 文件禁止提交 Git（已在 .gitignore 中排除）
# ⚠️  生产环境：请使用 CI/CD 变量注入 或 云服务商密钥管理服务
# ⚠️  生产环境启动时会自动校验关键密钥，不安全配置将拒绝启动
# ============================================================

# ---------- 服务配置 ----------
PORT=3000
NODE_ENV=development

# ---------- MongoDB [生产必改] ----------
# 本地开发: mongodb://localhost:27017/qudu
# 生产环境: 使用 MongoDB Atlas / 云数据库 并启用 TLS
# ⚠️ 生产环境校验会拒绝 localhost 地址
MONGODB_URI=mongodb://localhost:27017/qudu

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379

# ---------- JWT 密钥 [生产必改] ----------
# ⚠️ 生产环境必须使用强随机密钥，建议 32+ 字符
# 生产校验会拒绝默认值和长度不足的密钥
# 生成方式: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=请在此填入您的JWT密钥（32字符以上）
JWT_ACCESS_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d

# ---------- 短信服务 [生产必改] ----------
# MVP 阶段使用 mock，生产请替换为腾讯云/阿里云短信
# ⚠️ 生产环境使用 mock 会产生警告（用户无法收到验证码）
SMS_PROVIDER=mock
SMS_MOCK_CODE=123456

# 腾讯云短信配置示例（生产环境）:
# SMS_PROVIDER=qcloud
# QCLOUD_SMS_APP_ID=1400xxxxx
# QCLOUD_SMS_APP_KEY=xxxxxxxxxxxxxxxx
# QCLOUD_SMS_SIGN=字趣阅读

# ---------- 微信登录 [生产必改] ----------
# 请从微信公众平台获取
# ⚠️ 生产环境使用 mock 会产生警告
WECHAT_APPID=wx0000000000000000
WECHAT_SECRET=请在此填入微信应用密钥

# ---------- CORS 配置 [生产必改] ----------
# 允许的域名，逗号分隔
# 开发环境: http://localhost:3000,http://localhost:8080
# 生产环境: https://your-domain.com
# ⚠️ 生产环境仅包含 localhost 会产生警告
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ---------- 速率限制（可选覆盖） ----------
# 默认值已在 config/index.js 中配置，如需自定义可在此覆盖
# RATE_LIMIT_DEFAULT_MAX=100
# RATE_LIMIT_AUTH_MAX=10
# RATE_LIMIT_SMS_MAX=2
# RATE_LIMIT_TTS_MAX=30

# ---------- 可选: 云密钥服务集成 ----------
# 生产环境建议使用云密钥管理服务代替 .env 文件:
# - 阿里云 KMS: https://help.aliyun.com/product/28633.html
# - 腾讯云 SSM: https://cloud.tencent.com/product/ssm
# - AWS Secrets Manager: https://aws.amazon.com/secrets-manager/
#
# 使用方式: 在 CI/CD 流水线或 PM2 部署脚本中注入环境变量
# PM2 示例: 在 ecosystem.config.js 的 env_production 中配置
# Docker 示例: docker run --env-file /run/secrets/qudu-env ...
#
# KMS_PROVIDER=aliyun  # aliyun | qcloud | aws
