# 字趣阅读 - 后端环境配置
# 复制此文件为 .env 并填入实际值

# 服务端口
PORT=3000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/qudu

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-jwt-secret-change-in-production
JWT_ACCESS_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d

# 短信验证码（MVP阶段用模拟验证码）
SMS_PROVIDER=mock
SMS_MOCK_CODE=123456

# 阿里云OSS（后续配置）
OSS_REGION=cn-hangzhou
OSS_BUCKET=qudu-assets
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# 微信登录（后续配置）
WECHAT_APP_ID=
WECHAT_APP_SECRET=
