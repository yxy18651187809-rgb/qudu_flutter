# ============================================================
# 字趣阅读 - 环境变量配置模板
# ============================================================
# 复制此文件为 .env 并填入实际值
# 生产环境：请使用 CI/CD 变量注入 或 云服务商密钥管理服务
# ============================================================

# ---------- 服务配置 ----------
PORT=3000
NODE_ENV=development

# ---------- MongoDB ----------
# 本地开发: mongodb://localhost:27017/qudu
# 生产环境: 建议使用 MongoDB Atlas 并启用 TLS
MONGODB_URI=mongodb://localhost:27017/qudu

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379

# ---------- JWT 密钥 [生产必改] ----------
# ⚠️ 生产环境必须使用强随机密钥，建议 32+ 字符
# 生成方式: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=请在此填入您的JWT密钥（32字符以上）
JWT_ACCESS_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d

# ---------- 短信服务 [生产必改] ----------
# MVP 阶段使用 mock，生产请替换为腾讯云/阿里云短信
SMS_PROVIDER=mock
SMS_MOCK_CODE=123456

# 腾讯云短信配置示例（生产环境）:
# SMS_PROVIDER=qcloud
# QCLOUD_SMS_APP_ID=1400xxxxx
# QCLOUD_SMS_APP_KEY=xxxxxxxxxxxxxxxx
# QCLOUD_SMS_SIGN=字趣阅读

# ---------- 微信登录 [生产必改] ----------
# 请从微信公众平台获取
WECHAT_APPID=wx0000000000000000
WECHAT_SECRET=请在此填入微信应用密钥

# ---------- CORS 配置 [生产必改] ----------
# 允许的域名，逗号分隔
# 开发环境: http://localhost:3000,http://localhost:8080
# 生产环境: https://your-domain.com
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ---------- 可选: 云密钥服务集成 ----------
# 如使用 AWS Secrets Manager / 阿里云 KMS / 腾讯云 SSM
# 请取消下方注释并配置
# AWS_SECRET_MANAGER=arn:aws:secretsmanager:region:account:secret:qudu-api
# KMS_PROVIDER=aliyun  # aliyun | qcloud | aws
