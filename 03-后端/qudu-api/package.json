{
  "name": "qudu-api",
  "version": "1.0.0",
  "description": "字趣阅读 - 后端API服务",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "seed": "node scripts/seed.js",
    "seed:l2": "node scripts/seed_L2_books.js",
    "test": "jest --forceExit --detectOpenHandles",
    "test:integration": "jest tests/integration/ --forceExit --detectOpenHandles",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop qudu-api",
    "pm2:restart": "pm2 restart qudu-api",
    "pm2:logs": "pm2 logs qudu-api",
    "pm2:status": "pm2 status"
  },
  "dependencies": {
    "axios": "^1.16.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.6.3",
    "morgan": "^1.10.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "jest": "^30.3.0",
    "nodemon": "^3.0.1",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000,
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  }
}
